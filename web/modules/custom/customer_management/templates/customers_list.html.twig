{{ attach_library('core/drupal.dialog.ajax') }}

<div>
  <div class="user-management-view api-attribute-status-header">
    <header>
      {{ content.link }}
    </header>
  </div>

  <form method="get" action="{{ content.search.action }}" class="customer-management-search">
    <div class="rate-sheet-filter">
      <div class="rate-sheet-filter-name">
        <span class="attributes-label">Customer Name</span>
        <span class="attribute-inputs">
          <input type="search" name="customer_name" value="{{ content.search.customer_name }}" />
        </span>
      </div>
      <div class="rate-sheet-filter-name">
        <span class="attributes-label">Contact Email</span>
        <span class="attribute-inputs">
          <input type="search" name="contact_email" value="{{ content.search.contact_email }}" />
        </span>
      </div>
      <div class="rate-sheet-filter-name">
        <span class="attributes-label">&nbsp;</span>
        <span class="attribute-inputs">
          <button type="submit" class="button">Search</button>
          <a href="{{ content.search.action }}" class="button">Reset</a>
        </span>
      </div>
    </div>
  </form>

  <table class="attributes-table customer-management-table">
    <thead>
      <tr>
        <th>Customer Name</th>
        <th>Contact Name</th>
        <th>Contact Email</th>
        <th>Client ID</th>
        <th>Demand Partners</th>
        <th>Operations</th>
      </tr>
    </thead>
    <tbody>
      {% for customer in content.final %}
        <tr>
          <td>{{ customer.name }}</td>
          <td>{{ customer.contact_name }}</td>
          <td>{{ customer.contact_email }}</td>
          <td>{{ customer.client_id }}</td>
          <td>{{ customer.demand_partners }}</td>
          <td>
            <div class="edit-operation">
              <div class="edit-operation-wrap">
                {% for action in customer.actions %}
                  <a href="{{ action.disabled ? 'javascript:void(0)' : action.url }}" class="dropdown-item {{ action.class }} {% if action.ajax %}use-ajax{% endif %}">
                    {{ action.title }}
                  </a>
                {% endfor %}
              </div>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6">No customers found.</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  {{ content.pager }}
</div>
