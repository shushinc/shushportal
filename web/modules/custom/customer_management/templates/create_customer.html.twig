{{ form.customer_nid }}

<div class="rate-sheet-filter">
  <div class="rate-sheet-filter-name">
    <span class="attributes-label">Customer Name</span>
    <span class="attribute-inputs">{{ form.customer_name }}</span>
  </div>
  <div class="rate-sheet-filter-name">
    <span class="attributes-label">Contact Name</span>
    <span class="attribute-inputs">{{ form.contact_name }}</span>
  </div>
  <div class="rate-sheet-filter-currencies">
    <span class="attributes-label">Contact Email</span>
    <span class="attribute-inputs">{{ form.contact_email }}</span>
  </div>
  <div class="rate-sheet-filter-effective">
    <span class="attributes-label">Contact Phone</span>
    <span class="attribute-inputs">{{ form.contact_phone }}</span>
  </div>
</div>

<div class="rate-sheet-attributes">
  <span class="attribute-inputs">
    <div class="api-attribute-filter">
      <div class="api-attribute-filter">
        <div class="api-attribute-filter-control">
          <button type="button" class="button button--small customer-add-demand-partner" data-customer-add-demand-partner="">
            Add Demand Partner
          </button>
        </div>
      </div>
    </div>

    

    {% if form.client_id or form.hashed_key_display %}
      <div class="rate-sheet-linked-clients customer-management-credentials-section">
        <h3>Credentials</h3>

        {% if form.client_id %}
          <div class="customer-management-form-field">
            {{ form.client_id }}
          </div>
        {% endif %}

        {% if form.hashed_key_display %}
          <div class="customer-management-form-field customer-management-hashed-key-field">
            {{ form.hashed_key_display }}
            {{ form.hashed_key_actions }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if form.history %}
      <div class="rate-sheet-linked-clients customer-management-history-section">
        {{ form.history }}
      </div>
    {% endif %}

    {% if form.created_credentials_modal %}
      <div class="rate-sheet-linked-clients customer-management-created-credentials-section">
        {{ form.created_credentials_modal }}
      </div>
    {% endif %}
  </span>
</div>
