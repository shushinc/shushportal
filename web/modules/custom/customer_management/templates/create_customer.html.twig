<div class="customer-management-form">

  <h1 class="customer-management-form-title">
    {{ is_edit ? 'Edit Customer'|t : 'Add Customer'|t }}
  </h1>

  <div class="customer-management-form-grid">

    <div class="customer-management-form-field">
      {{ form.customer_name }}
    </div>

    <div class="customer-management-form-field">
      {{ form.contact_name }}
    </div>

    <div class="customer-management-form-field">
      {{ form.contact_email }}
    </div>

    <div class="customer-management-form-field">
      {{ form.contact_phone }}
    </div>

  </div>

  {% if is_edit and form.customer_client_id is defined %}
    <div class="customer-management-form-grid customer-management-credentials-section">

      <div class="customer-management-form-field">
        {{ form.customer_client_id }}
      </div>

      {% if form.hashed_key is defined %}
        <div class="customer-management-form-field customer-management-hashed-key-field">
          {{ form.hashed_key }}
        </div>
      {% endif %}

    </div>
  {% endif %}

  <div
    class="customer-management-demand-partners"
    data-customer-demand-partners-container
  >

    <div class="customer-management-demand-partners-card">

      <button
        type="button"
        class="button button--small customer-management-add-demand-partners rate-sheet-add-client"
        data-customer-add-demand-partners
      >
        {{ 'Add Demand Partners'|t }}
      </button>

      <div
        class="customer-management-selected-demand-partners"
        data-customer-selected-demand-partners
      ></div>

    </div>

  </div>

  {{ form.demand_partners }}
  {{ form.demand_partners_data }}
  {{ form.selected_demand_partners_data }}

  <div class="customer-management-form-actions">
    {{ form.actions }}

    <a
      href="{{ path('customer_management.list_customer') }}"
      class="customer-management-back-link"
    >
      {{ 'Back to customers'|t }}
    </a>
  </div>

  {{ form|without(
    'customer_name',
    'contact_name',
    'contact_email',
    'contact_phone',
    'customer_client_id',
    'hashed_key',
    'demand_partners',
    'demand_partners_data',
    'selected_demand_partners_data',
    'actions'
  ) }}

</div>